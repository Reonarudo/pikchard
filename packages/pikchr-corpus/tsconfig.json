{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // The corpus is files on disk, so reading it is the package's whole job.
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
