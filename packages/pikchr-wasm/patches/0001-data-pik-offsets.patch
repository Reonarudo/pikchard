+
+/* Byte offset of z[] within the input script, or -1 if z[] does not point
+** into it.  Not every token does: the "pikchr_date" keyword rewrites its
+** token to point at a static string literal.
+*/
+static int pik_src_offset(Pik *p, const char *z){
+  size_t d;
+  if( z==0 || p->sIn.z==0 ) return -1;
+  if( z<p->sIn.z ) return -1;
+  d = (size_t)(z - p->sIn.z);
+  if( d>=(size_t)p->sIn.n ) return -1;
+  return (int)d;
+}
+
+/* The 1-based offset to report for an object introduced by pTok.  The
+** tokenizer stamps every token it feeds to the parser (see pik_tokenize),
+** so this only falls back to the token text for tokens built elsewhere.
+** Returns 0 when there is none.  Offsets are stored 1-based so that a PObj
+** or PToken zeroed by memset() means "no offset" rather than "offset 0" —
+** the debug_label_color dots are rendered from exactly such an object.
+*/
+static int pik_token_offset1(Pik *p, PToken *pTok){
+  if( pTok->iSrcOfs1>0 ) return pTok->iSrcOfs1;
+  return pik_src_offset(p, pTok->z) + 1;
+}
+
+/* The byte offset of the statement that produced pObj, or -1 if there is
+** none.
+*/
+static int pik_obj_offset(Pik *p, PObj *pObj){
+  if( pObj->iSrcOfs1>0 ) return pObj->iSrcOfs1 - 1;
+  return pik_src_offset(p, pObj->errTok.z);
+}
+
+/* Append data-pik="N" to the SVG element being emitted, where N is the byte
+** offset of the statement that produced pObj.  Emits nothing when no offset
+** is recoverable.
+*/
+static void pik_append_datapik(Pik *p, PObj *pObj){
+  char buf[32];
+  int ofs = pik_obj_offset(p, pObj);
+  if( ofs<0 ) return;
+  snprintf(buf, sizeof(buf), " data-pik=\"%d\"", ofs);
   pik_append(p, buf, -1);
 }
 
