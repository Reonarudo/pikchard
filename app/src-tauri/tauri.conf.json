{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pikchard",
  "version": "0.1.0",
  "identifier": "dev.pikchard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pikchard",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; font-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A live editor for Pikchr diagrams",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": ["pikchr", "pik"],
        "name": "Pikchr diagram",
        "description": "Pikchr diagram",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "text/x-pikchr",
        "exportedType": {
          "identifier": "dev.pikchard.pikchr",
          "conformsTo": ["public.plain-text", "public.source-code"]
        }
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ],
    "linux": {
      "deb": {
        "depends": ["shared-mime-info", "desktop-file-utils"],
        "desktopTemplate": "linux/pikchard.desktop",
        "files": {
          "/usr/share/mime/packages/pikchard.xml": "linux/pikchard-mime.xml"
        }
      },
      "rpm": {
        "depends": ["shared-mime-info", "desktop-file-utils"],
        "desktopTemplate": "linux/pikchard.desktop",
        "files": {
          "/usr/share/mime/packages/pikchard.xml": "linux/pikchard-mime.xml"
        }
      }
    }
  }
}
