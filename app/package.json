{
  "name": "@pikchard/app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "The Pikchard application: React + Vite on the web, Tauri on the desktop",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --grep-invert @budget",
    "budget": "playwright test --project=chromium --grep @budget",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/markdown": "^1.8.1",
    "@pikchard/lang-pikchr": "*",
    "@pikchard/pikchr-wasm": "*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "^7.4.1"
  }
}
